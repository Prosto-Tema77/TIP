#include <iostream>

using namespace std;

int main() {
    double x, y;
    if (!(cin >> x >> y)) return 0;

    double total = x;      // Общая сумма отмытых денег
    double current = x;    // Сумма за текущий день
    int day = 1;           // Номер дня

    // Бесконечный цикл for без параметров (все три блока пусты)
    for (;;) {
        // Проверяем условие досрочного выхода из цикла: если ФНС уже может заинтересоваться
        if (total >= y) {
            break;         // Прерываем бесконечный цикл
        }
        current *= 1.1;    // Увеличиваем сумму текущего дня на 10%
        total += current;  // Добавляем к общей сумме
        day++;             // Увеличиваем счетчик дней
    }

    cout << day << "\n";
    return 0;
}
